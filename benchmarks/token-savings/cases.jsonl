# Versioned case set for `trovex eval` (src/trovex/eval_harness.py), scored against the
# PINNED corpus in corpus/ (the same fictional "Acme Notes API" docs the token-savings
# benchmark uses) so the eval stays reproducible and dependency-free like that benchmark.
#
# category taxonomy (this harness's C1-C8, matching eval_bench.CATEGORIES):
#   C1 exact-terminology lookup, single unambiguous doc
#   C2 paraphrase of a C1-style question (different words, same doc)
#   C3 cross-cutting question spanning >1 doc
#   C4 a specific config/env-var/flag lookup
#   C5 procedural "how do I do X" (a step sequence)
#   C6 miss-case — NOT answerable from the corpus at all (in_corpus=false, correct answer
#      is to abstain, expected_docs is empty on purpose)
#   C7 ambiguous phrasing that could plausibly route to the wrong doc (a loss-prone trap)
#   C8 terse/adversarial phrasing of an otherwise in-corpus question
#
# `#`-prefixed lines and blank lines are ignored by the loader.
{"query": "how do I create an api token", "category": "C1", "expected_docs": ["authentication.md"]}
{"query": "how do I revoke a token", "category": "C1", "expected_docs": ["authentication.md"]}
{"query": "what happens to the cache when a note is edited", "category": "C1", "expected_docs": ["caching.md"]}
{"query": "what environment variable sets the data directory", "category": "C1", "expected_docs": ["configuration.md"]}
{"query": "what database does it use", "category": "C1", "expected_docs": ["database.md"]}
{"query": "how do I run it under systemd", "category": "C1", "expected_docs": ["deployment.md"]}
{"query": "does acme notes send my data anywhere", "category": "C1", "expected_docs": ["faq.md"]}
{"query": "what are the install requirements", "category": "C1", "expected_docs": ["install.md"]}
